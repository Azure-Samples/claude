{
  "name": "azure-samples/claude-php-sample",
  "description": "Claude on Microsoft Foundry through the standard Anthropic PHP SDK client",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "anthropic-ai/sdk": "~1.3.0",
    "guzzlehttp/guzzle": "^7.9"
  },
  "autoload": {
    "psr-4": {
      "ClaudeSample\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": false
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "php -d zend.assertions=1 -d assert.exception=1 tests/run.php"
  }
}

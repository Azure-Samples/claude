# --- Required ---------------------------------------------------------------
# Surfaced via modelProviderData on the Claude deployment.
# Industry is required: choose the lowercase value matching your organization.
CLAUDE_ORGANIZATION_NAME=Your Organization
CLAUDE_COUNTRY_CODE=US
# INDUSTRY=technology
# Legacy CLAUDE_INDUSTRY values are migrated automatically by the azd hook.

# --- Optional ---------------------------------------------------------------
AZURE_LOCATION=eastus2
AZURE_BASE_NAME=claude

# Per-family deployments (preferred). Set any combination; empty = skip.
# CLAUDE_HAIKU_MODEL=claude-haiku-5-5
# CLAUDE_SONNET_MODEL=claude-sonnet-5-5
# CLAUDE_OPUS_MODEL=claude-opus-5-5
# CLAUDE_HAIKU_CAPACITY=25
# CLAUDE_SONNET_CAPACITY=25
# CLAUDE_OPUS_CAPACITY=25

# Legacy single-deployment fallback (only used when all CLAUDE_*_MODEL above are empty).
CLAUDE_MODEL_NAME=claude-sonnet-4-6
CLAUDE_MODEL_VERSION=1
CLAUDE_MODEL_CAPACITY=25

# Grant `Cognitive Services User` (least-privilege inference role, GUID
# a97b65f3-24c7-4388-baec-2e87135dc908) to AZURE_PRINCIPAL_ID on the Foundry
# account during `azd up`. Requires Microsoft.Authorization/roleAssignments/write
# on the deployer.
# ASSIGN_RBAC=true

# Let the postprovision hook run the official Claude Code installer if `claude` isn't on PATH.
# CLAUDE_CODE_AUTO_INSTALL=true

# Populated automatically by `azd up` after provisioning. You can also set
# these manually if running the sample standalone.
# CLAUDE_BASE_URL=https://<resource>.services.ai.azure.com/anthropic
# CLAUDE_DEPLOYMENT_NAME=claude-sonnet-4-6-abc123
# AZURE_TENANT_ID=<tenant-id>  # Optional: scope SDK token requests to the deployment tenant.

# Portable SDK samples (process env; Python also loads gitignored .env.local).
# Canonical endpoint/model/key form one profile; do not mix it with CLAUDE_* keys.
# ANTHROPIC_BASE_URL=https://<resource>.services.ai.azure.com/anthropic
# ANTHROPIC_MODEL=<deployment-name>
# AUTH_MODE=bearer  # Required explicitly with ANTHROPIC_BASE_URL.
# AZURE_TOKEN_CREDENTIALS=AzureCliCredential
# TOKEN_SCOPE=https://ai.azure.com/.default
# API-key authentication defaults to Authorization: Bearer and preserves SDK API version.
# Optional legacy overrides: ANTHROPIC_API_VERSION=2023-06-01, API_KEY_HEADER=x-api-key.
# Native provider: AUTH_MODE=api_key, ANTHROPIC_BASE_URL=https://api.anthropic.com.
# Supply the native API key through a secret store or process environment.
